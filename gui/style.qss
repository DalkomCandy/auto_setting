/* 엑셀 매크로 봇 — 스타일시트 (독립 실행, 외부 의존 없음) */

* {
    font-family: 'Malgun Gothic', 'Segoe UI', sans-serif;
    font-size: 12px;
    color: #1d1d1f;
}

QMainWindow, QDialog {
    background-color: #f5f5f7;
}

QWidget#panel {
    background-color: #ffffff;
    border: 1px solid #e5e5ea;
    border-radius: 10px;
}

/* ── 그룹 ─────────────────────────────────────── */
QGroupBox {
    font-weight: 600;
    font-size: 13px;
    color: #0071e3;
    border: none;
    border-top: 1px solid #e5e5ea;
    background-color: transparent;
    margin-top: 14px;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 0 4px 0;
    left: 0px;
}

/* ── 입력 ─────────────────────────────────────── */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    padding: 4px 9px;
    border: 1px solid #e0e0e5;
    border-radius: 6px;
    background-color: #fbfbfd;
    min-height: 24px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #0071e3;
    background-color: #ffffff;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #b0b0b5;
}

QComboBox::drop-down { border: none; width: 18px; margin-right: 4px; }

QLabel { color: #1d1d1f; }
QFormLayout QLabel { color: #3a3a3e; font-weight: 500; }

QLabel[hint="true"] {
    color: #86868b;
    font-size: 11px;
}

QLabel[headline="true"] {
    font-size: 15px;
    font-weight: 700;
    color: #1d1d1f;
}

/* ── 버튼 ─────────────────────────────────────── */
QPushButton {
    padding: 6px 14px;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    background-color: #409cf8;
    color: white;
    min-height: 24px;
}
QPushButton:hover   { background-color: #71b4f7; }
QPushButton:pressed { background-color: #4f7194; }
QPushButton:disabled { background-color: #d8d8dd; color: #9a9aa0; }

QPushButton[secondary="true"] {
    background-color: #f0f0f5;
    color: #1d1d1f;
}
QPushButton[secondary="true"]:hover    { background-color: #e5e5ea; color: #0071e3; }
QPushButton[secondary="true"]:disabled { background-color: #f6f6f8; color: #bcbcc2; }

QPushButton[primary="true"]       { background-color: #34c759; }
QPushButton[primary="true"]:hover { background-color: #32d75b; }

QPushButton[danger="true"]       { background-color: #ff3b30; }
QPushButton[danger="true"]:hover { background-color: #ff4f44; }

/* ── 표 ───────────────────────────────────────── */
QTableWidget {
    border: 1px solid #e5e5ea;
    border-radius: 8px;
    background-color: #ffffff;
    gridline-color: #f2f2f7;
    alternate-background-color: #fbfbfd;
    outline: none;
}

QTableWidget::item { padding: 4px 6px; }
QTableWidget::item:selected { background-color: #e4eef9; color: #1d1d1f; }

QHeaderView::section {
    background-color: #f6f9fc;
    border: none;
    border-bottom: 2px solid #eef2f6;
    border-right: 1px solid #f2f2f7;
    font-weight: 700;
    color: #505055;
    min-height: 28px;
    padding-left: 8px;
}

/* ── 진행률 ───────────────────────────────────── */
QProgressBar {
    border: none;
    background-color: #eff0f5;
    border-radius: 3px;
    max-height: 6px;
}
QProgressBar::chunk { background-color: #0071e3; border-radius: 3px; }

/* ── 콘솔 ─────────────────────────────────────── */
QTextEdit {
    border: 1px solid #e5e5ea;
    border-radius: 8px;
    background-color: #fbfbfd;
    padding: 8px;
    font-family: 'D2Coding', 'Consolas', 'Malgun Gothic', monospace;
    font-size: 11px;
}

/* ── 체크박스 ─────────────────────────────────── */
QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 15px; height: 15px;
    border: 2px solid #c8c8cc;
    border-radius: 4px;
    background-color: #ffffff;
}
QCheckBox::indicator:checked { background-color: #0071e3; border-color: #0071e3; }
QCheckBox::indicator:hover   { border-color: #0071e3; }

/* ── 스크롤바 ─────────────────────────────────── */
QScrollBar:vertical   { background: transparent; width: 8px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 0; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #d1d1d6;
    border-radius: 4px;
    min-height: 30px;
    min-width: 30px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: #8e8e93;
}
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* ── 기타 ─────────────────────────────────────── */
QSplitter::handle { background-color: #e8e8ed; }
QSplitter::handle:hover { background-color: #0071e3; }

QStatusBar {
    background-color: #f9f9fb;
    color: #86868b;
    border-top: 1px solid #ebebeb;
}

QToolTip {
    background-color: #1d1d1f;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
}

QScrollArea { border: none; background-color: transparent; }
QScrollArea > QWidget > QWidget { background-color: transparent; }
